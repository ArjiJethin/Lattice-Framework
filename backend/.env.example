# =============================================================================
# Lattice Backend environment template
# Copy to Backend/.env and adjust. No real secrets belong in this file.
# All variables use the LATTICE_ prefix. HOST/PORT/DEBUG/ENVIRONMENT/CORS_ORIGINS
# are also accepted without the prefix for backward compatibility with Phase 0.
# =============================================================================

# --- Service identity / transport -------------------------------------------
LATTICE_ENVIRONMENT=development
LATTICE_DEBUG=false
LATTICE_LOG_LEVEL=INFO
LATTICE_HOST=127.0.0.1
LATTICE_PORT=8000
LATTICE_API_PREFIX=/api/v1
# Comma-separated origins (no surrounding quotes).
LATTICE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
LATTICE_CORS_ALLOW_CREDENTIALS=false

# --- Persistence -------------------------------------------------------------
# SQLite URL. Relative paths resolve against Backend/; absolute Windows paths
# look like: sqlite:///C:/path/to/lattice.db
LATTICE_DATABASE_URL=sqlite:///./data/lattice.db
LATTICE_SQLITE_BUSY_TIMEOUT_MS=5000
# Create missing tables at startup (never drops data). Set false if you apply
# Alembic migrations yourself.
LATTICE_AUTO_CREATE_SCHEMA=true

# --- Model path policy -------------------------------------------------------
# Semicolon- or comma-separated approved roots. Paths are resolved and must live
# inside one of these directories unless unrooted paths are explicitly allowed.
LATTICE_MODEL_ROOTS=../models
LATTICE_ALLOW_UNROOTED_MODEL_PATHS=false

# --- Runtime -----------------------------------------------------------------
# auto = first installed non-test adapter; llamacpp = optional real adapter;
# fake = TEST ONLY (requires LATTICE_RUNTIME_ALLOW_FAKE=true).
LATTICE_RUNTIME_ADAPTER=auto
LATTICE_RUNTIME_ALLOW_FAKE=false
LATTICE_RUNTIME_MODEL_CACHE_SIZE=1
LATTICE_RUNTIME_DEFAULT_TIMEOUT_SECONDS=120

# --- Bounded in-process job manager -----------------------------------------
LATTICE_JOB_MAX_WORKERS=1
LATTICE_JOB_MAX_PENDING=16
LATTICE_JOB_SHUTDOWN_GRACE_SECONDS=10
LATTICE_JOB_RECOVER_INTERRUPTED_ON_STARTUP=true

# --- Benchmark protocol bounds ----------------------------------------------
LATTICE_BENCHMARK_DEFAULT_REPETITIONS=3
LATTICE_BENCHMARK_RECOMMENDED_REPETITIONS=5
LATTICE_BENCHMARK_MAX_REPETITIONS=20
LATTICE_BENCHMARK_DEFAULT_WARMUPS=1
LATTICE_BENCHMARK_MAX_WARMUPS=5
LATTICE_BENCHMARK_DEFAULT_TIMEOUT_SECONDS=120
LATTICE_BENCHMARK_MAX_TIMEOUT_SECONDS=900
LATTICE_BENCHMARK_CONTINUE_ON_REPETITION_ERROR=true

# --- Request / generation bounds --------------------------------------------
LATTICE_MAX_PROMPT_CHARS=16000
LATTICE_MAX_OUTPUT_TOKENS=2048
LATTICE_MAX_CONTEXT_LENGTH=131072
LATTICE_MAX_THREADS=256
LATTICE_MAX_BATCH_SIZE=8192
LATTICE_MAX_GPU_LAYERS=999

# --- Telemetry ---------------------------------------------------------------
# Memory sampling interval for observed-peak RSS/VRAM during repetitions.
LATTICE_MEMORY_SAMPLING_INTERVAL_MS=50
# Optional GPU telemetry (NVML if installed, else nvidia-smi if present).
LATTICE_GPU_TELEMETRY_ENABLED=true
LATTICE_GPU_COLLECTOR_TIMEOUT_SECONDS=2.0
# Advisory preflight RAM headroom ratio (0.15 = require 15% free).
LATTICE_MEMORY_SAFETY_MARGIN_RATIO=0.15
# advisory (permit unknown estimates, record warning) or strict (reject them).
LATTICE_PREFLIGHT_POLICY=advisory

# --- Optimization evidence policy -------------------------------------------
LATTICE_EVIDENCE_MAX_AGE_HOURS=168
LATTICE_EVIDENCE_MIN_SUCCESSFUL_REPETITIONS=1
LATTICE_ALLOW_ESTIMATED_METRICS_IN_DECISIONS=false
# TEST ONLY escape hatch: when true, fake-runtime evidence may inform decisions.
# Default false; fake runs are always tagged test_only either way.
LATTICE_ALLOW_TEST_ONLY_OPTIMIZATION_EVIDENCE=false

# --- Privacy -----------------------------------------------------------------
# When false (default) `retain_output=true` requests are rejected.
LATTICE_ALLOW_OUTPUT_RETENTION=false
LATTICE_MAX_RETAINED_OUTPUT_CHARS=8000

# --- History / import-export -------------------------------------------------
LATTICE_PAGINATION_DEFAULT_LIMIT=50
LATTICE_PAGINATION_MAX_LIMIT=200
LATTICE_MAX_IMPORT_RECORDS=500
LATTICE_HISTORY_EXPORT_MAX_RUNS=1000
